# Default settings for the Waveshare ESP32-S3-Touch-AMOLED-1.75.
# ESP-IDF reads this file when it first creates `sdkconfig` (which is not committed).
# After changing it, delete `sdkconfig` or run `idf.py fullclean` to apply.

# Chip
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 16 MB flash, with a 4 MB app partition (partitions.csv)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 8 MB octal PSRAM (ESP32-S3R8)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# The Wi-Fi and lwIP buffers in PSRAM: kept in internal RAM, a burst of incoming packets
# (the catalogue) left the puck with 14 KB of it, and the link stalled.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Logs over the board's USB-C port (the ESP32-S3's built-in USB Serial/JTAG)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 1 ms tick, smoother timing for drawing later
CONFIG_FREERTOS_HZ=1000

# Room for a burst of incoming packets (the catalogue's parts) while the link task is busy:
# lwIP's default of 6 dropped most of each burst.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32

# Big text for reading at arm's length
CONFIG_LV_FONT_MONTSERRAT_28=y
# Labels on the sky map (main/sky_objects.c).
CONFIG_LV_FONT_MONTSERRAT_20=y
# QR codes, for pairing with the app (Nayuki's QR generator, MIT, inside LVGL)
CONFIG_LV_USE_QRCODE=y
# Don't compile LVGL's own examples and demos: hundreds of files the puck never uses.
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set

# WebRTC (libpeer): DTLS with SRTP keys, and a self-made certificate. mbedTLS's buffers go to
# PSRAM, to keep the internal memory for Wi-Fi and drawing.
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y
CONFIG_MBEDTLS_X509_CREATE_C=y
# Keep the phone's certificate after the handshake, so its fingerprint can be checked.
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Optimised for speed (-O2), not for debugging: drawing the sky map needs it.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Screenshots over the USB cable (main/screenshot.c, tools/screenshot.py).
CONFIG_LV_USE_SNAPSHOT=y
